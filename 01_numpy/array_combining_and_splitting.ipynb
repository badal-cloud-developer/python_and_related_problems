    "#concatenate of arrays\n",
    "\n",
    "import numpy as np\n",
    "arr1=np.array([2,3,4,5,6,7,8])\n",
    "arr2=np.array([9,10,11,12,13,14,15])\n",
    "\n",
    "print(np.concatenate([arr1,arr2]))"
   ]
